# Airtable (system of record)
AIRTABLE_API_KEY=
AIRTABLE_BASE_ID=

# Outbound cold email (SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=
FROM_NAME=

# Reply watching (IMAP, same mailbox as SMTP_USER in most setups)
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASS=

# ManyChat (Instagram/WhatsApp DM, official API only)
MANYCHAT_API_TOKEN=
MANYCHAT_WEBHOOK_SECRET=

# Calendly
CALENDLY_API_TOKEN=
CALENDLY_WEBHOOK_SIGNING_KEY=

# Shared secret the dashboard sends as the x-app-secret header when it calls
# mutating routes (e.g. /api/scrape). Generate any random string.
APP_ACTION_SECRET=

# Protects the /api/cron/* routes from being called by anyone but Vercel Cron.
# Vercel sets this automatically as a bearer token when CRON_SECRET is defined
# as an env var on the project; generate any random string and set it in both places.
CRON_SECRET=
